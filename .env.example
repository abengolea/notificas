# Firebase Configuration
# Copy this file to .env.local and fill in your Firebase credentials

# URL pública de la app (SSR seguro; evita confiar en el header Host)
# Desarrollo: puerto de `npm run dev` (ej. 9006). Producción: https://tudominio.com
# Importante en producción: enlaces del certificado PDF (adjuntos, etc.) usan esta base.
NEXT_PUBLIC_APP_URL=http://localhost:9006
# Código de Google Search Console (meta verification), si lo usás.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# QR y enlaces de validación: si APP_URL es localhost, se usa https://notificas.com.ar
# NEXT_PUBLIC_VERIFY_URL=https://notificas.com.ar

NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
# Copia lacrada 5 años (WORM). No es el bucket de Firebase; no guardar campañas acá.
# EVIDENCE_STORAGE_BUCKET=notificas-f9953-evidence
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Firebase Admin SDK (service account - para API routes)
# Obtener de Firebase Console > Project Settings > Service Accounts > Generate new private key
# Puede repetir NEXT_PUBLIC_FIREBASE_PROJECT_ID si no definís FIREBASE_PROJECT_ID aparte.
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Panel /admin — login y cookies HttpOnly (/api/admin/*). Generá ADMIN_SESSION_SECRET largo aleatorio (p. ej. openssl rand -hex 32).
ADMIN_PANEL_EMAIL=admin@ejemplo.com
ADMIN_PANEL_PASSWORD=definí_una_fuerte_en_local
ADMIN_SESSION_SECRET=reemplazar_por_secreto_largo_y_único
# Google en /admin/login: el email de ADMIN_PANEL_EMAIL siempre puede entrar.
# Extra: más cuentas de Google, separadas por coma.
# ADMIN_ALLOWED_EMAILS=otro@ejemplo.com

# Descuento colegio — nómina en LegalMev (mismo secret en ambas apps)
# LEGALMEV_URL=https://www.legalmev.com.ar
# NOTIFICAS_LEGALMEV_SHARED_SECRET=generar_con_openssl_rand_hex_32
# Descuento para usuarios registrados en LegalMev (sin envíos gratis; default 20)
# LEGALMEV_REGISTERED_DISCOUNT_PERCENT=20

# Demo módulo empresas (opcional; valores por defecto en scripts/seed-demo-empresa.js)
# DEMO_EMPRESA_EMAIL=demo.empresa@notificas.local
# DEMO_EMPRESA_PASSWORD=DemoEmpresa2026!

# Polygon Mainnet - Red real con POL
# Chain ID: 137 | Currency: POL | Explorer: https://polygonscan.com
# Obtén POL en Binance u otros exchanges

POLYGON_PRIVATE_KEY=your_private_key_without_0x
POLYGON_PROVIDER_URL=https://polygon-bor-rpc.publicnode.com
POLYGON_WALLET_ADDRESS=0xYOUR_DESTINATION_ADDRESS

# ── Cola asíncrona de campañas (Cloud Tasks) ──────────────────────────────────────────────
# Secret compartido entre Next.js y los workers para autenticar tareas de Cloud Tasks.
# Generá con: openssl rand -hex 32
CAMPAIGN_WORKER_SECRET=generar_con_openssl_rand_hex_32

# Nombre de la cola en Cloud Tasks (crear con: gcloud tasks queues create campaign-notifications --location=us-central1)
CLOUD_TASKS_QUEUE=campaign-notifications

# Región donde vivé la cola (debe coincidir con la región del proyecto Firebase).
CLOUD_TASKS_LOCATION=us-central1

# Formulario "Contáctenos" — Firestore `mail` + Cloud Function `sendEmail` + SMTP (Donweb).
# Valores por defecto del código (src/lib/mail-defaults.ts); solo descomentá o cambiá si hace falta.
FIREBASE_SENDEMAIL_URL=https://sendemail-ju7n3yysfq-uc.a.run.app
# La Cloud Function sendEmail exige el mismo secreto en header X-Certify-Secret
# POLYGON_CERTIFY_SECRET=generar_con_openssl_rand_hex_32
#
# WhatsApp Cloud API — App Secret de Meta (firma del webhook). Sin esto, delivered/read se pueden inventar.
# El mismo valor en App Hosting y en Secret Manager de la CF whatsappWebhook.
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# Token de sistema (solo servidor) para consultas Graph API. Nunca exponer al navegador.
# El mismo secreto que Functions: WHATSAPP_ACCESS_TOKEN.
# WHATSAPP_ACCESS_TOKEN=
# IDs de la cuenta WABA usados al enviar (se sellan en el snapshot; no leerlos “vivos” años después).
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# Rebotes SMTP: Donweb no tiene webhook. Si reenviás el DSN a processIncomingEmail
# o POST /api/email/bounce con X-Certify-Secret, se asocia al mail (Message-ID / X-Notificas-Mail-Id).
# EMAIL_PROVIDER=resend
# Rollback SMTP DonWeb: EMAIL_PROVIDER=donweb
# RESEND_WEBHOOK_SECRET=whsec_...  (signing secret del webhook en Resend; no la API key)
# RESEND_API_KEY=re_...            (consulta en vivo GET /emails/{id} en verificación Resend)
CONTACT_INBOX_EMAIL=contacto@notificas.com
CONTACT_FORM_CREATED_BY=contact-form-web

# Mercado Pago (Checkout Pro): token de la app en developers.mercadopago.com
# El mismo ACCESS_TOKEN debe ser la misma cuenta/seller que use Notificas Hub para GET /v1/payments/{id}.
# MERCADOPAGO_ACCESS_TOKEN=
# Webhook Mercado Pago: dejalo apuntando a esta app para acreditar créditos.
# Si NEXT_PUBLIC_APP_URL no es HTTPS, usá la base pública del deploy de Notificas:
# MERCADOPAGO_WEBHOOK_PUBLIC_BASE_URL=https://tu-dominio-o-apphosting.web.app
# Solo usar MERCADOPAGO_NOTIFICATION_URL si querés forzar la URL completa del webhook de ESTA app.
# MERCADOPAGO_NOTIFICATION_URL=https://notificas.com.ar/api/mercadopago/webhook
# Opcional: query que MP repetirá al notificar (sólo si el Hub valida así; Bearer MP no puede mandar desde MP sin proxy).
# MERCADOPAGO_NOTIFICATION_URL_QUERY=clave=valor
# Hub — hub_emit_factura en metadata (= "true" sólo si esto es exactamente true)
# MERCADOPAGO_HUB_EMIT_FACTURA=true
# Opcional tipo comprobante en metadata (A|B|C)
# MERCADOPAGO_HUB_CBTE_TIPO=B
#
# Facturación ARCA vía Notificas Hub: llamada servidor a servidor después de pago aprobado.
# NOTIFICASHUB_URL=https://notificashub--studio-3864746689-59018.us-east4.hosted.app
# NOTIFICASHUB_BILLING_EMIT_URL=http://localhost:3000/api/integrations/notificas/billing/emit
# NOTIFICAS_BILLING_SHARED_SECRET=misma_clave_en_notificashub
#
# Opcional mapping cliente Hub: campo string hubBillingClienteId en users/{uid} o users/{uid}.perfil.hubBillingClienteId
# = doc id en Firestore del Hub colección billing_recurrente_clients. Si omitís: se usa el Auth uid como doc id esperado.

# ── API pública v1 (/api/v1) ─────────────────────────────────────────────────
# Pepper para hashear API Keys. Si no está, se deriva de ADMIN_SESSION_SECRET.
# PUBLIC_API_KEY_PEPPER=
# Cifrado AES-GCM de secretos de webhook (whsec_). Si no está, se deriva igual.
# PUBLIC_API_ENCRYPTION_KEY=
# Rate limits por API Key / ventana de 60s
# PUBLIC_API_RATE_LIMIT_GENERAL=120
# PUBLIC_API_RATE_LIMIT_NOTIFICATIONS=30
# PUBLIC_API_RATE_LIMIT_BATCHES=5
# Allowlist sandbox (además de organizations.apiSandboxAllowlist)
# PUBLIC_API_SANDBOX_ALLOWLIST_PHONES=+5491112345678
# PUBLIC_API_SANDBOX_ALLOWLIST_EMAILS=dev@empresa.com

# ── MCP remoto (ChatGPT / Claude) ─────────────────────────────────────────────
# Desactivado por defecto. No habilitar en producción sin allowlist.
# MCP_ENABLED=true
# MCP_ALLOW_ALL=true
# MCP_ALLOWED_USERS=uid_de_prueba,tu@email.com
# MCP_BASE_URL=http://localhost:9006
# MCP_RATE_LIMIT_READ=60
# MCP_RATE_LIMIT_PREPARE=20
# MCP_RATE_LIMIT_WRITE=5
# MCP_RATE_LIMIT_TENANT_READ=120
# MCP_RATE_LIMIT_TENANT_PREPARE=40
# MCP_RATE_LIMIT_TENANT_WRITE=10
# MCP_OAUTH_ACCESS_TTL_SECONDS=3600
# MCP_OAUTH_REFRESH_TTL_SECONDS=2592000

# ── Adhesiones electrónicas (todas las empresas) ─────────────────────────────
# Desactivado por defecto. Kill switch: sin ART_MODULE_ENABLED no hay módulo.
# ART_MODULE_ENABLED=true                 # habilita adhesiones para todas las orgs
# NEXT_PUBLIC_ART_MODULE_ENABLED=true     # solo UX/menú; NUNCA autoriza el módulo
# ART_PILOT_MODE=true                     # evidencia TEST + caps/allowlist solo en ART_ALLOWED_ORGS
# ART_GENERAL_RELEASE_ENABLED=true        # legado; MODULE=true ya abre a todas las orgs
# ART_ALLOWED_ORGS=orgId_piloto           # orgs a las que aplican los tope del piloto
# ART_PILOT_EMAIL_ALLOWLIST=tu@dominio.com
# ART_PILOT_PHONE_ALLOWLIST=+54911...
# ART_PILOT_MAX_RECIPIENTS=10
# ART_PILOT_MAX_CAMPAIGN_RECIPIENTS=10
# EVIDENCE_RETENTION_YEARS=5              # metadata/UI. NO cambia el lock WORM del bucket.
# ART_INVITE_TTL_HOURS=336
# ART_OTP_TTL_MINUTES=10
# ART_OTP_MAX_ATTEMPTS=5
# OTP WhatsApp AUTH (no envía el enlace de adhesión; el alta sigue por email).
# ART_WHATSAPP_OTP_ENABLED=true
# ART_WHATSAPP_OTP_TEMPLATE=notificas_verificacion_identidad
# ART_WHATSAPP_OTP_LANG=es

# ── CRM marketing admin ─────────────────────────────────────────────────────
# From SMTP (Resend autoriza @notificas.com.ar). Contacto visible en el pie: contacto@notificas.com
# MARKETING_FROM_EMAIL=contacto@notificas.com.ar
# MARKETING_CONTACT_EMAIL=contacto@notificas.com
# MARKETING_FROM_NAME=Notificas
# MARKETING_REPLY_TO=adrianbengolea@notificas.com
# MARKETING_GMAIL_EMAIL=adrianbengolea@notificas.com
# OAuth de Gmail (solo lectura) para sincronizar respuestas. Crear cliente en Google Cloud
# con redirect: {NEXT_PUBLIC_APP_URL}/api/admin/marketing/gmail/callback
# GOOGLE_MARKETING_OAUTH_CLIENT_ID=
# GOOGLE_MARKETING_OAUTH_CLIENT_SECRET=
# GOOGLE_MARKETING_OAUTH_REDIRECT_URI=http://localhost:9006/api/admin/marketing/gmail/callback
# MARKETING_HMAC_SECRET=generar_con_openssl_rand_hex_32
# MARKETING_SEND_BATCH=8
# MARKETING_WORKSPACE_ID=notificas-internal
#
# CRM flags (default off). Ninguna es NEXT_PUBLIC.
# CRM_V2=true
# CRM_AI=true
# CRM_MCP=true
# LinkedIn Assistant (extensión Chrome + /api/linkedin-assistant/*)
# LINKEDIN_ASSISTANT_TOKEN=generar_con_openssl_rand_hex_32
# LINKEDIN_ASSISTANT_CONNECTION_REVIEW_DAYS=4
# LINKEDIN_ASSISTANT_POSTPONE_DAYS=1
#
# CRM_MCP_TOKEN=generar_con_openssl_rand_hex_32
# CRM_MCP_CLIENT_ID=
# CRM_MCP_CLIENT_SECRET=
# CRM_MCP_ALLOWED_USERS=usuario@notificas.com.ar
# GEMINI_API_KEY=
# GOOGLE_GENAI_API_KEY=
# GEMINI_CRM_MODEL=gemini-2.0-flash
# GEMINI_CRM_MODEL_FAST=gemini-2.0-flash

